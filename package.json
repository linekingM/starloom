{
  "name": "starloom",
  "version": "1.0.0",
  "private": true,
  "description": "星枢织阵 (Starloom) — 凝练麻将博弈灵魂的星律共鸣塔防游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "playwright-core": "^1.52.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.1.1"
  }
}
